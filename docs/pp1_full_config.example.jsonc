// pp1 全量配置示例（阅读版）
// 说明：
// 1. 这是 JSONC，允许 `//` 注释；机器加载请用同目录的 pp1_full_config.example.json。
// 2. `params` 全部是默认值；`world.root` / `request` 是样例值，换成你的城市与 OD。
// 3. 正式配置可以只写要改的键；未写的键走默认。
// 4. 本库 OD 是空中航段端点，不含机巢地面起降；端点 z 换算出的真高必须落在 [agl_min_m, agl_max_m]。

{
  // ===== 数据与建场 =====
  "world": {
    // 必填；默认 null。城市数据目录；相对路径按进程 cwd，生产建议绝对路径
    "root": "data/worlds/guangzhou",
    // 默认 true；没有 dem.tif 时设为 false，地面按 0
    "with_dem": true,
    // 默认 "Height"；建筑高度字段名
    "height_field": "Height",
    // 默认 1.0 m²；小于该面积的 footprint 碎片丢弃
    "min_area_m2": 1.0,
    // 默认 0.0 m；建筑接地形时的最低 base_z
    "terrain_min_z_m": 0.0,
    // 默认 "startup"；可选 "on_demand"（只用于调试）
    "field_mode": "startup",
    // 默认 3000.0 m；单条 OD 水平长度上限；调大同时放大 pad/内存，需重建场
    "max_od_length_m": 3000.0,
    // 默认 null = 数据目录下 nofly.geojson（文件可没有）；显式给了就必须存在
    "nofly_path": null,
    // 默认 "absolute"；禁飞区输入高度口径。
    // absolute = 读 properties.z_min_m / z_max_m（绝对高程，库内统一存储口径）；
    // agl      = 读 properties.agl_min_m / agl_max_m，并由 DEM 换算成绝对 z。
    // 两种字段不能混用；agl 模式必须 with_dem=true。
    "nofly_altitude_mode": "absolute"
  },

  // ===== 本次请求：由 request_from_config() 读取 =====
  "request": {
    // 必填；默认 null。空中航段起点 ENU 米（不是经纬度）；不含机巢地面起降
    "start_xy": [1636.8, 4198.2],
    // 必填；默认 null。空中航段终点 ENU 米
    "goal_xy": [2040.6, 1393.6],
    // 必填；默认 null。起点绝对 z（与 x/y 同一高程基准，不是 AGL、不是相对高度）
    "start_z_m": 37.5,
    // 默认 null；null = 与起点同高。终点绝对 z；不是“到地面”
    "goal_z_m": 37.09
  },

  // ===== 规划参数：在 create_context 时固定，请求期不能换 =====
  "params": {
    "roi": {
      // 默认 0.2；走廊总宽 = width_ratio × 起终点水平距离
      "width_ratio": 0.2,
      // 默认 null；直接指定走廊半宽（米），非 null 时优先于 width_ratio；轨迹硬约束
      "half_width_m": null,
      // 默认 50.0 m；栅格窗口两端额外留白；只垫栅格，不放宽交付边界
      "margin_m": 50.0
    },
    // 默认 [4.0, 4.0, 2.0] m；一次改三样：算力/内存、建筑膨胀、SDF 容差
    "spacing_m": [4.0, 4.0, 2.0],
    // 默认 10.0 / 120.0 m；飞行带（AGL）
    "agl_min_m": 10.0,
    "agl_max_m": 120.0,
    // 默认 0；RRT 随机种子
    "seed": 0,
    "vehicle": {
      // 默认 20.0 m/s；最大地速
      "v_max_mps": 20.0,
      // 默认 3.0 m/s²；最大加速度
      "a_max_mps2": 3.0,
      // 默认 5.0 m；交付净空
      "clearance_m": 5.0,
      // 默认 100.0 N；最大推力
      "thrust_max_n": 100.0,
      // 默认 5.0 kg；起飞质量
      "mass_kg": 5.0
    },
    "planner": {
      // 默认 60；NLP 固定节点数
      "n_resample": 60,
      // 默认 2；每段配点采样数
      "segment_samples": 2,
      // 默认 0.001 / 500.0 s；NLP 时间步下限/上限
      "dt_min_s": 0.001,
      "dt_max_s": 500.0,
      // 默认 1.0 s；NLP 初始时间步
      "initial_time_step_s": 1.0,
      // 默认 200；IPOPT 迭代上限
      "ipopt_max_iter": 200,
      // 默认 60.0 / 20.0 m；RRT 步长/最小步长
      "rrt_step_m": 60.0,
      "rrt_min_step_m": 20.0,
      // 默认 0.4；RRT 步长按 SDF 缩放
      "rrt_sdf_step_scale": 0.4,
      // 默认 3000；RRT 最大迭代
      "rrt_max_iters": 3000,
      // 默认 0.1；目标采样概率
      "rrt_goal_sample_rate": 0.1,
      // 默认 200；捷径化迭代
      "rrt_shortcut_iters": 200,
      // 默认 1.0 m；净空沿线检查步长；RRT 与真几何复核共用
      "clearance_sample_step_m": 1.0,
      // 默认 5；范围 1–20；多初值次数（seed+i 跑 N 次 RRT，选一条作为 NLP 初值）
      "rrt_initializations": 5
    }
  }
}
